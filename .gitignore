*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code. We ignore .vscode/ everywhere by default, then surgically un-ignore
# only the root .vscode/launch.json so the PixelCode / PixelDock launch
# configs travel with the repo. The 4-line dance is needed because git can't
# un-exclude a file whose parent directory is fully ignored.
.vscode/
!/.vscode/
/.vscode/*
!/.vscode/launch.json

# Claude Code: track shared agent definitions, ignore per-machine local config.
.claude/settings.local.json

