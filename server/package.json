{
  "name": "pixel-code-server",
  "version": "0.3.0",
  "description": "WebSocket server wrapping Claude Agent SDK for PixelCode",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "bin": {
    "pixelcode-server": "./bin/pixelcode-server.mjs"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
